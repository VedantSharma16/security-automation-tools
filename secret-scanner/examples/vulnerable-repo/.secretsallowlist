# Example .secretsallowlist for this demo repo.
#
# Each line is `kind:value`:
#   path:<glob>    -- suppress all findings under files matching this glob
#   rule:<rule_id> -- suppress all findings from this rule, everywhere
#   regex:<regex>  -- suppress findings whose raw matched secret matches this regex
#   literal:<value> -- suppress a findings whose raw matched secret equals this value exactly

# The JWT in tests/test_auth.py is a fixture, not a live session token.
path:tests/**
